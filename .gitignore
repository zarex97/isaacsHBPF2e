node_modules/

# Built LevelDB compendium packs. Source of truth is content/**.json — run `npm run build`.
packs/
# Intermediate staging directory used by the build.
.staging/

*.log
.DS_Store

# Generated by `gitnexus analyze`, which writes the same block into both AGENTS.md
# and CLAUDE.md. CLAUDE.md is this repo's one tracked instruction file, so the
# duplicate is ignored rather than suppressed: `--skip-agents-md` would also stop
# CLAUDE.md's block being refreshed, which is the half worth keeping current.
AGENTS.md

# CodeGraph's per-project index. Removed from this repo in favour of GitNexus,
# but ignored so a stray `codegraph init` can never commit a database again.
.codegraph/

# GitNexus skill files, reinstalled by `gitnexus setup` (which also puts twelve of
# them in ~/.claude/skills/, making these a redundant subset). Scoped to skills/
# rather than all of .claude/ on purpose: settings.json, commands/ and agents/
# live there too, and those are worth sharing if we ever add them.
.claude/skills/

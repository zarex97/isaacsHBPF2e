                },
                {
                    "apply": {
                        "effect": [
                            "Effect: Kendō — Unresisted",
                            "Effect: Kendō — Opened Guard"
                        ],
                        "type": "expire"
                    },
                    "event": "strike-resolved",
                    "note": "“Make **one** Strike.” Neither face can be scoped by a predicate: the AC penalty sits on the **defender's** AC, where `item:` means the defender's own items, and the bypass belongs to the attacker. Driven live, predicating the ephemeral effect caught an unarmed fist it had no business reaching, and predicating the modifier caught nothing at all. So the scope is the clause's own word — one Strike — and both are retired the moment one resolves.",
                    "self": true
                }
            ]
        }
